#!/usr/bin/env bash
# Fake GitHub CLI. Repositories are bare repos under $FAKE_GH/<owner>/<name>.git.
echo "gh $*" >> "$FAKE_LOG"
repo_flag() { local p=""; while [ $# -gt 0 ]; do [ "$1" = -R ] && p=$2; shift; done; echo "$p"; }
case "$1 $2" in
  "auth status") exit 0 ;;
  "api user") echo "devuser" ;;
  "api user/orgs") echo "acme-org" ;;
  "repo view")
    r=$3; [ -d "$FAKE_GH/$r.git" ] || { echo "not found" >&2; exit 1; }
    case "$*" in *defaultBranchRef*) git --git-dir="$FAKE_GH/$r.git" symbolic-ref --short HEAD 2>/dev/null || echo "";; *) echo "{\"name\":\"$r\"}";; esac ;;
  "repo create")
    r=$3; mkdir -p "$FAKE_GH/$(dirname "$r")"; git init -q --bare "$FAKE_GH/$r.git"
    b=$(git symbolic-ref --short HEAD); git --git-dir="$FAKE_GH/$r.git" symbolic-ref HEAD "refs/heads/$b"
    git remote add github "https://github.com/$r.git" && git push -q -u github HEAD 2>&1 && echo "https://github.com/$r" ;;
  "api repos/"*)
    r=${2#repos/}
    case "$r" in
      */issues/*/comments) cat "$FAKE_COMMENT" 2>/dev/null ;;
      *) if git --git-dir="$FAKE_GH/$r.git" rev-parse -q --verify HEAD >/dev/null 2>&1; then echo false; else echo true; fi ;;
    esac ;;
  "secret list") r=$(repo_flag "$@"); cat "$FAKE_STATE/secrets-$(echo "$r" | tr / _)" 2>/dev/null; printf '%s\n' ${FAKE_SECRETS:-} ;;
  "secret set") r=$(repo_flag "$@"); v=$(cat); echo "$3" >> "$FAKE_STATE/secrets-$(echo "$r" | tr / _)"; echo "secret $3 set (${#v} chars)" >> "$FAKE_LOG" ;;
  "pr create") echo "https://github.com/$(repo_flag "$@")/pull/7" ;;
  "run list") echo 4242 ;;
  "run view")
    n=$(cat "$FAKE_STATE/run-polls" 2>/dev/null || echo 0); echo $((n + 1)) > "$FAKE_STATE/run-polls"
    if [ "$n" -lt 1 ]; then printf 'RUN\tin_progress\t\nqa / Plan\tcompleted\tsuccess\nqa / Code checks\tin_progress\t\nqa / Deploy\tqueued\t\n'
    else printf 'RUN\tcompleted\tsuccess\nqa / Plan\tcompleted\tsuccess\nqa / Code checks\tcompleted\tsuccess\nqa / PHPUnit\tcompleted\tsuccess\nqa / Deploy\tcompleted\tsuccess\nqa / Behat\tcompleted\tsuccess\nqa / Summary\tcompleted\tsuccess\n'; fi ;;
  *) echo "fake gh: unhandled $*" >&2; exit 3 ;;
esac
