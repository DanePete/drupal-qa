#!/usr/bin/env bash
# Fake GitHub CLI. Repositories are bare repos under $FAKE_GH/<owner>/<name>.git.
echo "gh $*" >> "$FAKE_LOG"
repo_flag() { local p=""; while [ $# -gt 0 ]; do [ "$1" = -R ] && p=$2; shift; done; echo "$p"; }
case "$1 $2" in
  "auth status") exit 0 ;;
  "api user") echo "devuser" ;;
  "api user/orgs") echo "acme-org" ;;
  "repo view")
    r=$3; [ -d "$FAKE_GH/$r.git" ] || { echo "not found" >&2; exit 1; }
    case "$*" in
      *defaultBranchRef*) git --git-dir="$FAKE_GH/$r.git" symbolic-ref --short HEAD 2>/dev/null || echo "" ;;
      *) echo "{\"name\":\"$r\"}" ;;
    esac ;;
  "repo create")
    r=$3
    if [ -n "${FAKE_GH_CREATE_FAILS:-}" ] && [ ! -e "$FAKE_STATE/create-refused" ]; then
      touch "$FAKE_STATE/create-refused"
      echo "GraphQL: devuser cannot create repositories here" >&2
      exit 1
    fi
    if [[ "$*" == *--internal* ]]; then
      echo "internal repositories can only be created within an organization" >&2
      exit 1
    fi
    mkdir -p "$FAKE_GH/$(dirname "$r")"; git init -q --bare "$FAKE_GH/$r.git"
    b=$(git symbolic-ref --short HEAD); git --git-dir="$FAKE_GH/$r.git" symbolic-ref HEAD "refs/heads/$b"
    git remote add github "https://github.com/$r.git" && git push -q -u github HEAD 2>&1 \
      && echo "https://github.com/$r" ;;
  "api orgs/"*) echo "${FAKE_ORG_PLAN:-team}" ;;
  "api repos/"*)
    r=${2#repos/}
    case "$r" in
      */issues/*/comments) cat "$FAKE_COMMENT" 2>/dev/null ;;
      *) # Is the repository empty?
        if git --git-dir="$FAKE_GH/$r.git" rev-parse -q --verify HEAD >/dev/null 2>&1; then
          echo false
        else
          echo true
        fi ;;
    esac ;;
  "secret list")
    cat "$FAKE_STATE/secrets-$(repo_flag "$@" | tr / _)" 2>/dev/null
    read -r -a preset <<< "${FAKE_SECRETS:-}"
    [ ${#preset[@]} -gt 0 ] && printf '%s\n' "${preset[@]}"
    exit 0 ;;
  "secret set")
    v=$(cat)
    echo "$3" >> "$FAKE_STATE/secrets-$(repo_flag "$@" | tr / _)"
    echo "secret $3 set (${#v} chars)" >> "$FAKE_LOG" ;;
  "pr create") echo "https://github.com/$(repo_flag "$@")/pull/7" ;;
  "run list")
    # The run appears on the second poll, as it does on GitHub.
    n=$(cat "$FAKE_STATE/run-list-polls" 2>/dev/null || echo 0); echo $((n + 1)) > "$FAKE_STATE/run-list-polls"
    [ "$n" -ge 1 ] && echo 4242 ;;
  "run view")
    n=$(cat "$FAKE_STATE/run-polls" 2>/dev/null || echo 0); echo $((n + 1)) > "$FAKE_STATE/run-polls"
    # One poll mid-run, then finished: one job per line, tab-separated.
    if [ "$n" -lt 1 ]; then
      printf '%s\t%s\t%s\n' RUN in_progress "" "qa / Plan" completed success \
        "qa / Code checks" in_progress "" "qa / Deploy" queued ""
    else
      printf '%s\tcompleted\tsuccess\n' RUN "qa / Plan" "qa / Code checks" "qa / PHPUnit" \
        "qa / Deploy" "qa / Behat" "qa / Summary"
    fi ;;
  *) echo "fake gh: unhandled $*" >&2; exit 3 ;;
esac
