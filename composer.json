{
    "name": "thronedigital/drupal-qa",
    "description": "CI for Drupal on Pantheon: checks and a tested multidev for every pull request, and safe deploys.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "drupal",
        "pantheon",
        "ci",
        "github-actions",
        "phpcs",
        "phpstan",
        "phpunit",
        "behat"
    ],
    "authors": [
        {
            "name": "Dane Petersen"
        },
        {
            "name": "August Ash",
            "homepage": "https://augustash.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "behat/mink": "^1.11",
        "drupal/coder": "^8.3.24 || ^9.0",
        "drupal/drupal-extension": "^5.4",
        "mglaman/phpstan-drupal": "^1.2.12 || ^2.0",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.10 || ^2.1",
        "phpstan/phpstan-deprecation-rules": "^1.1 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10 || ^11",
        "symfony/phpunit-bridge": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "DrupalQa\\": "src/"
        }
    },
    "bin": [
        "bin/drupal-qa-setup"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
